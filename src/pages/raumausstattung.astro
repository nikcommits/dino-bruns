---
import Layout from '../layouts/Layout.astro';
import PartnerTrust from '../components/PartnerTrust.astro';
import ProjectPlanner from '../components/ProjectPlanner.astro';
import GalleryLightbox from '../components/GalleryLightbox.astro';
import galleryData from '../data/galleryData.json';

const leistungen = [
  {
    id: 'energiesparen',
    slug: 'energiesparen',
    title: 'Energiesparen mit Wabenplissee',
    category: 'ISOLIERUNG & FENSTERTECHNIK',
    originalHeadline: 'Start zum Energiesparen …',
    partner: 'Germania Rollo • KADECO • Duette® • Teba',
    image: '/images/energiesparen/Teba-DUETTE-Bad-Pascal-Walter-512.jpg',
    images: galleryData.energiesparen || [],
    description:
      'Sparen Sie Energie und damit bares Geld mit unserem Wabenplissee an Ihrem Fenster. Durch die spezielle Wabenstruktur wirkt das Wabenplissee wie ein isolierendes Luftpolster zwischen Wohnraum und Fensterfläche. So wird im Winter der Wärmeverlust am Fenster messbar reduziert, und im Sommer heizen sich die Räume deutlich weniger auf. Das Wabenplissee ist kein reines Funktionsprodukt, sondern verbindet textile Wohnraumästhetik mit handfestem Energiesparen in allen Farben, Dessins und Schienenausführungen.',
    benefits: [
      'Isolierendes Luftpolster reduziert Wärmeverlust im Winter spürbar',
      'Effektiver Hitzestopp im Sommer bei vollem Tageslicht',
      'Montage mit Klebeleiste, Klemmträgern oder fester Verschraubung',
      'Fenster lassen sich weiterhin uneingeschränkt öffnen und kippen',
      'Harmonisch angepasste Schienen und ergonomische Griffdesigns',
    ],
    tag: 'Energiesparen',
  },
  {
    id: 'innenausbau',
    slug: 'innenausbau',
    title: 'Innenausbau & Komplettsanierung',
    category: 'MEISTERHANDWERK AUS EINER HAND',
    originalHeadline: 'Innenausbau – die gesamte Bandbreite',
    partner: 'Dino Bruns Meisterbetrieb & Verbundpartner',
    image: '/images/innenausbau/IMG_5529-512.jpg',
    images: galleryData.innenausbau || [],
    description:
      'Dank unserer jahrzehntelangen Erfahrung bieten wir Ihnen die gesamte Bandbreite des hochwertigen Innenausbaus. Vom Trockenbau inklusive aller Abriss-, Umbau- und Verputzarbeiten über Elektroinstallationen, Lichttechnik, Maler-, Stuckateur- und Glaserarbeiten bis hin zu individuellen Schreinerarbeiten einschließlich Fenster und Türen sowie Schlosser- und Fliesenarbeiten. Alles wird individuell auf Ihre Raumarchitektur abgestimmt – mit verlässlichen Terminen, bei denen alle Gewerke Hand in Hand gehen.',
    benefits: [
      'Trockenbau, Akustikdecken & maßgeschneiderte Wandgestaltungen',
      'Elektroinstallationen, moderne Lichtvouten & Stuckprofile (Orac Decor)',
      'Schreiner-, Maler-, Glaser- und Schlosserarbeiten aus einer Hand',
      'Vollständige Altbau- und Villensanierung inklusive Badsanierung',
      'Persönliche Bauleitung & termintreue Meisterkoordination',
    ],
    tag: 'Innenausbau',
  },
  {
    id: 'bodenbelaege',
    slug: 'bodenbelag',
    title: 'Bodenbeläge & Design-Vinyl',
    category: 'DESIGN-ESTRICH, PARKETT & VINYL',
    originalHeadline: 'Bodenbeläge – für alle Gelegenheiten',
    partner: 'Project Floors • Amtico • mFLOR • Moduleo • objectflor • HIS Parkett',
    image: '/images/bodenbelag/IMG_3136-512.jpg',
    images: galleryData.bodenbelag || [],
    description:
      'Anspruchsvolles Design, hochwertige Verarbeitung und kompromisslose Funktionalität sind die Stärken unserer Bodenbeläge. Mit einer umfangreichen Produktpalette von Echtholz-Parkett über edle Teppichböden bis hin zu extrem strapazierfähigen, feuchtigkeitsunempfindlichen und pflegeleichten Design-Vinylböden (LVT) lassen sich nahezu alle Raumideen verwirklichen – im Privatbereich ebenso wie in hoch frequentierten Geschäftsräumen.',
    benefits: [
      'Authentische Fischgrät-, Landhausdielen- und Naturstein-Fliesenoptiken',
      'Extrem abriebfest, fußwarm, leise Trittschallakustik und pflegeleicht',
      'Optimal geeignet für Fußbodenheizungen und Sanierungen bei geringer Aufbauhöhe',
      'Komplette Untergrundvorbereitung, Spachtelung und meisterhafte Verlegung',
      'Große Musterauswahl führender Hersteller im Krefelder Showroom',
    ],
    tag: 'Bodenbeläge',
  },
  {
    id: 'schiebetueren',
    slug: 'schiebetueren',
    title: 'Schiebetüren & Raumteilersysteme',
    category: 'ALUMINIUM, GLAS & SYSTEMMÖBEL',
    originalHeadline: 'Schiebetüren – auf Maß und individuell …',
    partner: 'Advantage-Wohnwelt • Imbusch Systemmöbel',
    image: '/images/schiebetueren/P1000264-512.jpg',
    images: galleryData.schiebetueren || [],
    description:
      'Dank der extremen Stabilität hochwertiger Aluminiumkonstruktionen sind Konstruktionen mit schlankesten Profilen und besonders großzügigen Glasflächen möglich. Sie bieten dort, wo gewünscht, ein Maximum an Transparenz, Lichtdurchflutung und moderner Raumgliederung. Erweitern oder zonieren Sie mit wenigen leichten Griffen Ihren Wohn- oder Arbeitsbereich – maßgeschneidert auf Ihre Decken- und Wandmaße.',
    benefits: [
      'Schlankeste Aluminiumprofile für maximale Glasflächen und Tageslicht',
      'Flüsterleise, kugelgelagerte Laufwerke und langlebige Bodenschienen',
      'Flexible Raumteilung für Ankleiden, Homeoffices, Küchen und Wohnräume',
      'Individuelle Füllungen: Klarglas, Mattglas, Holzpaneele oder Farbglas',
      'Millimetergenaues Aufmaß und saubere Montage durch unser Fachteam',
    ],
    tag: 'Schiebetüren',
  },
  {
    id: 'vorhangsysteme',
    slug: 'vorhangsysteme',
    title: 'Vorhangsysteme & Wellenvorhänge',
    category: 'INTERSTIL DESIGN-SYSTEME & TECHNIK',
    originalHeadline: 'Vorhangsysteme – gutes Design ist kein Zufall.',
    partner: 'interstil Diedrichsen • JAB Anstoetz • Chivasso',
    image: '/images/vorhangsysteme/interstil-milieu-f1-wandsystem-512.jpg',
    images: galleryData.vorhangsysteme || [],
    description:
      'Vorhangsysteme von interstil für Wand- oder Deckenmontage in zeitgemäßen Oberflächen wie geschliffenem Edelstahl, Aluminium mattiert, anthrazit oder verchromt. Die patentierten Gleitelemente bleiben im Profil unsichtbar verborgen und bewegen Ihre Vorhänge flüsterleise und mit perfektem Wellenfall – selbst über große Spannweiten und durch individuelle Sonderbiegungen für Erker und Giebelverglasungen.',
    benefits: [
      'Verdeckte Innenlauf-Gleiter für perfekt fallende Wellenvorhänge',
      'Wand- und Deckenmontage mit filigranen Trägern oder deckenbündigem Einbau',
      'Individuelle Maßbiegungen für Erker, Rundungen und Dachschrägen',
      'Exklusive Metalle: Edelstahl massiv, Aluminium handgebürstet, Chrom, Schwarz',
      'Auf Wunsch motorisiert mit smarter Fern- oder App-Steuerung',
    ],
    tag: 'Vorhangsysteme',
  },
  {
    id: 'teppiche',
    slug: 'teppiche',
    title: 'Maßteppiche & Handgefertigte Unikate',
    category: 'JAB ANSTOETZ, KYMO & BRINK & CAMPMAN',
    originalHeadline: 'Maßteppiche – ein Hauch von Tradition',
    partner: 'JAB Josef Anstoetz • kymo • Brink & Campman • Longbarn • Girloon',
    image: '/images/teppiche/kymo-residential-dzine-elena-residence-los-altos-1-512.jpg',
    images: galleryData.teppiche || [],
    description:
      'Ob abgepasster Teppich in Sonderform oder handgefertigtes Unikat führender Manufakturen: Die ausgewählten Qualitäten bieten für jeden Einrichtungsstil den perfekten Akzent mit außergewöhnlicher Textur und sinnlicher Haptik. Ausgewählte Naturmaterialien wie Schurwolle, Leinen und Seide oder funktionale Hightech-Fasern garantieren, dass die edlen Teppiche auch bei intensiver Nutzung dauerhaft ihre Form und Brillanz bewahren.',
    benefits: [
      'Freie Wahl von Maßen, geometrischen Formen, Bordüren und Einfassungen',
      'Erstklassige Naturfasern (Schurwolle, Tencel) oder strapazierfähige Spezialgarne',
      'Hervorragende Trittschalldämmung und fühlbare Verbesserung der Raumakustik',
      'Einfassungen: Lederband, Alcantara, Nubuk, Baumwollband oder blind gekettelt',
      'Umfangreiches Musterarchiv im Krefelder Atelier zum Anfassen und Testen',
    ],
    tag: 'Maßteppiche',
  },
  {
    id: 'dekorationen',
    slug: 'dekorationen',
    title: 'Dekorationen & Moos-Akustikwände',
    category: 'TEXTILE RAUMKUNST & BIOPHILIC DESIGN',
    originalHeadline: 'Dekorationen – das Tüpfelchen auf dem i',
    partner: 'styleGREEN (FlowerArt) • Dedar • Zimmer + Rohde • Nya Nordiska • Kinnasand',
    image: '/images/dekorationen/IMG_1421-512.jpg',
    images: galleryData.dekorationen || [],
    description:
      'Ihre individuellen Vorstellungen und Raumwünsche bringen uns auf neue Ideen. Wir stehen Ihnen von Beginn an zur Seite und übernehmen die ganzheitliche Material-, Farb- und Akustikberatung sowie die handwerkliche Maßkonfektion. Ein besonderes Highlight sind unsere 100% natürlichen, wartungsfreien Moos- und Pflanzenwände von styleGREEN, die natürliche Ruhe und beste Schallabsorption in moderne Wohn- und Arbeitsräume bringen.',
    benefits: [
      'Ganzheitliche Farb-, Licht-, Akustik- und Textilkonzepte für anspruchsvolle Räume',
      'styleGREEN Moos- und Pflanzenwände: 100% natürlich konserviert, 0% Pflegeaufwand',
      'Exklusive Deko- & Polsterstoffe von Dedar Milano, Zimmer + Rohde und Nya Nordiska',
      'Maßgeschneiderte Kissen, Hussen, Tagesdecken und Wandbespannungen',
      'Für private Wohnresidenzen ebenso wie für repräsentative Kanzleien und Arztpraxen',
    ],
    tag: 'Dekorationen',
  },
  {
    id: 'sonnenschutz',
    slug: 'sonnenschutz',
    title: 'Sicht- & Sonnenschutz nach Maß',
    category: 'JALOUSIEN, ROLLOS & VERTIKALLAMELLEN',
    originalHeadline: 'Perfekter Schutz vor Sicht und Sonne …',
    partner: 'Germania Rollo • KADECO • Teba • Wood & Washi',
    image: '/images/sonnenschutz/germania-vvb-110-512.jpg',
    images: galleryData.sonnenschutz || [],
    description:
      'Mit dem passenden Sicht- und Sonnenschutz regulieren Sie nicht nur das einfallende Sonnenlicht, sondern inszenieren Ihre ganz persönliche Raumatmosphäre. Wir bieten Ihnen eine maßgefertigte, riesige Auswahl an Holzjalousien, textilen Rollos, Vertikallamellen und japanischen Wood & Washi Paneelen – perfekt abgestimmt auf Fenstergeometrie und Einrichtungsstil.',
    benefits: [
      'Maßgefertigte Holzjalousien aus nachhaltiger Forstwirtschaft, Plissees und Rollos',
      'Blendfreies Arbeiten am Bildschirm bei natürlicher Lichtdurchflutung',
      'Bedienoptionen: Ergonomischer Mittelgriff, Kettenzug, Schnur oder Funkmotor',
      'Feuchtraumgeeignete Beschichtungen für Küchen und Badezimmer',
      'Exakte Montage ohne Beschädigung von Fensterrahmen durch Spezialträger',
    ],
    tag: 'Sonnenschutz',
  },
  {
    id: 'bettwaesche',
    slug: 'bettwaesche',
    title: 'Christian Fischbacher Luxusbettwäsche',
    category: 'SCHWEIZER MANUFAKTURTRADITION AUS ST. GALLEN',
    originalHeadline: 'Bettwäsche – höchste Standards in Ökologie und Qualität',
    partner: 'Christian Fischbacher Co. AG (St. Gallen, Schweiz)',
    image: '/images/bettwaesche/fischbacher-bw-felino-512.jpg',
    images: galleryData.bettwaesche || [],
    description:
      'Einer der weltweit angesehensten Hersteller feinster Bettwäsche ist die Schweizer Manufaktur Christian Fischbacher aus St. Gallen. Das traditionsreiche Haus steht seit über zwei Jahrhunderten für mit viel Handarbeit gefertigte Bettwäsche aus feinstem Schweizer Baumwollsatin, Seide und Leinen. Höchste ökologische Standards, künstlerische Dessins und unvergleichlicher Schlafkomfort zeichnen jedes Set aus.',
    benefits: [
      'Feinster Schweizer Baumwollsatin mit edlem Seidenglanz und sanftem Griff',
      'Ökologisch nachhaltig gefärbt, schadstofffrei und langlebig strapazierfähig',
      'Künstlerische Dessins, handgezeichnete Motive und zeitlose Uni-Kollektionen',
      'Perfekte Passform mit hochwertigen Reißverschlüssen oder Knopfleisten',
      'Exklusive Kollektionskataloge und Stoffproben im Showroom Krefeld einsehbar',
    ],
    tag: 'Bettwäsche',
  },
];

const partnerKategorien = [
  {
    kategorie: 'Mineralische Oberflächen & Bäder',
    firmen: [
      { name: 'Frescolori.de GmbH', ort: 'Bocholt', info: 'Kalkmarmorputz & fugenlose Badbeschichtung' },
      { name: 'Krefelder Fliesenstudio Kiosse', ort: 'Krefeld', info: 'Exklusive Fliesen & Großkeramik' },
      { name: 'Schmidt-Rudersdorf', ort: 'Düsseldorf', info: 'Keramische Fliesen & Badkonzepte' },
    ],
  },
  {
    kategorie: 'Design-Bodenbeläge & Parkett',
    firmen: [
      { name: 'Project Floors GmbH', ort: 'Hürth', info: 'LVT Design-Vinylbeläge in Fischgrät & Dielen' },
      { name: 'Amtico International', ort: 'Neuss', info: 'High-End Designböden & Akzentstreifen' },
      { name: 'mFLOR International', ort: 'Twello (NL)', info: 'Formstabile Design-Böden' },
      { name: 'Houtindustrie Schijndel (HIS)', ort: 'Schijndel (NL)', info: 'Edles Manufaktur-Parkett' },
      { name: 'objectflor Art & Design', ort: 'Köln', info: 'Strapazierfähige Objektbeläge' },
    ],
  },
  {
    kategorie: 'Vorhangsysteme, Schienen & Schiebetüren',
    firmen: [
      { name: 'interstil Diedrichsen', ort: 'Steinhagen', info: 'Patentierte Vorhang- und Deckensysteme' },
      { name: 'Advantage-Wohnwelt / Imbusch', ort: 'Löningen', info: 'Aluminium-Glasschiebetüren nach Maß' },
      { name: 'Orac Decor', ort: 'Oostende (BE)', info: 'Stuck-, Licht- und Sockelleisten' },
    ],
  },
  {
    kategorie: 'Stoffe, Maßteppiche & Akustik',
    firmen: [
      { name: 'JAB Josef Anstoetz / Chivasso', ort: 'Bielefeld', info: 'Maßteppiche & Dekorationsstoffe' },
      { name: 'Christian Fischbacher', ort: 'St. Gallen (CH)', info: 'Luxusbettwäsche & edle Vorhangstoffe' },
      { name: 'Dedar Milano', ort: 'Appiano Gentile (IT)', info: 'Italienische Haute-Couture-Textilien' },
      { name: 'Zimmer + Rohde', ort: 'Oberursel', info: 'Moderne europäische Textilkunst' },
      { name: 'kymo GmbH', ort: 'Karlsruhe', info: 'Contemporary Custom Rugs' },
      { name: 'styleGREEN (FlowerArt)', ort: 'München', info: 'Konservierte Moos- & Pflanzenwände' },

---
import Layout from '../layouts/Layout.astro';
import ProjectPlanner from '../components/ProjectPlanner.astro';
import GalleryLightbox from '../components/GalleryLightbox.astro';
import galleryData from '../data/galleryData.json';

const betonboeden = galleryData.betonboden || [];
const betonwaende = galleryData.betonwand || [];
const allBetonImages = [...betonboeden, ...betonwaende];

const faqs = [
  {
    q: 'Wie werden die Betonoptik-Böden bei Dino Bruns gefertigt?',
    a: 'Die hier dargestellten Betonoptikböden bestechen dadurch, dass sie nicht »gespachtelt« aufgetragen, sondern in einem speziellen Gieß- und Schüttverfahren auf die Oberfläche gebracht werden. So kann die Masse in sich verlaufen. Dies führt immer zu einem einzigartigen, lebendigen Bild – jeder Kunde erhält sein persönliches Unikat.',
  },
  {
    q: 'Welche Varianten gibt es für Betonböden?',
    a: 'Böden in Betonoptik gibt es in verschiedensten Ausführungen: als geglättete Betonfläche oder als geschliffenen Estrich, »naturbelassen grau« oder individuell eingefärbt, seidenmatt oder glänzend versiegelt. Eine entsprechende Oberflächenversiegelung verleiht dem Boden zusätzlich die gewünschte Rutschfestigkeit und Fleckresistenz.',
  },
  {
    q: 'Woraus bestehen die Sichtbetonwände von Dino Bruns?',
    a: 'Unsere Betonwände bestehen aus einem hochwertigen Kalk-Marmor-Gemisch mit abschließender Versiegelung und Wachsbeschichtung, was der Wand ihren charakteristischen, edlen und »speckigen« Loft-Charakter verleiht. Farben, Hell-Dunkel-Nuancen sowie Einschlüsse (Lunker) können Sie im Vorfeld individuell mitbestimmen.',
  },
  {
    q: 'Eignen sich die Böden für Gewerbe und privaten Wohnraum?',
    a: 'Ja. Was früher vor allem in repräsentativen Gewerbeobjekten wie Boutiquen, Autohäusern oder Möbelhäusern geschätzt wurde, verleiht heute auch privaten Wohnräumen zeitlose, puristische Klasse und urbane Atmosphäre.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};
---

<Layout
  title="Betonböden & Betonwände Krefeld | Dino Bruns Raumdesign"
  description="Böden in Betonoptik im Gieß- und Schüttverfahren sowie handgefertigte Betonwände aus Kalk-Marmor-Gemisch von Raumausstatter Dino Bruns in Krefeld."
  schema={faqSchema}
>
  <!-- Hero Section -->
  <section class="relative bg-[#0a0a0a] text-white py-20 lg:py-28 border-b border-white/10 overflow-hidden bg-ambient-spotlight">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-7 space-y-6">
          <div class="text-xs uppercase tracking-[0.2em] font-medium text-[#f0dc28]">
            Raumausstatter Dino Bruns • Krefeld & Rheinland
          </div>

          <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-normal leading-tight">
            Betonböden & Wände – jeder Raum ein Unikat.
          </h1>

          <p class="text-base sm:text-lg text-neutral-300 font-normal leading-relaxed">
            Fugenlose Bodenbeschichtungen im Gießverfahren und edle Sichtbetonwände mit Wachsbeschichtung. Entdecken Sie über 60 Originalprojekte aus privaten Residenzen, Penthouses und repräsentativen Gewerbeobjekten.
          </p>

          <div class="pt-4 flex flex-col sm:flex-row gap-4">
            <button
              type="button"
              data-open-gallery="beton"
              data-gallery-title="Betonböden & Wände – Gesamte Galerie"
              data-gallery-images={JSON.stringify(allBetonImages)}
              data-start-index="0"
              class="inline-flex items-center justify-center px-8 py-4 text-xs font-semibold uppercase tracking-widest text-black bg-[#f0dc28] hover:bg-white transition-all shadow cursor-pointer"
            >
              Alle 61 Betonprojekte ansehen →
            </button>
            <a
              href="/kontakt"
              class="inline-flex items-center justify-center px-8 py-4 text-xs font-medium tracking-widest text-white border border-white/20 hover:border-[#f0dc28] hover:text-[#f0dc28] transition-all bg-[#121212]"
            >
              Musterplatten anfordern
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="border border-white/15 bg-black p-2 shadow-2xl aspect-[4/3] relative group cursor-pointer"
            data-open-gallery="beton"
            data-gallery-title="Fugenloser Betonboden Dino Bruns"
            data-gallery-images={JSON.stringify(allBetonImages)}
            data-start-index="0"
          >
            <img
              src="/images/betonboden/IMG_9740-512.jpg"
              alt="Fugenloser Design-Betonboden Dino Bruns"
              class="w-full h-full object-cover okc-image-hover"
              loading="eager"
            />
            <div class="absolute bottom-4 left-4 bg-black/80 backdrop-blur-md px-3 py-1.5 border border-white/15 text-[11px] text-[#f0dc28] font-mono">
              61 Originalfotos verfügbar
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Technical Description -->
  <section class="py-20 bg-[#0e0e0e] text-white border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <div id="boeden" class="lg:col-span-6 space-y-6 scroll-mt-28">
          <span class="text-xs uppercase tracking-[0.2em] font-medium text-[#f0dc28]">
            Handwerkliche Fertigung • Böden
          </span>
          <h2 class="font-serif text-3xl sm:text-4xl font-normal text-white leading-tight">
            Im Gieß- und Schüttverfahren gefertigt.
          </h2>
          <p class="text-sm text-neutral-300 leading-relaxed font-normal">
            Die hier dargestellten Betonoptikböden bestechen dadurch, dass sie nicht »gespachtelt« aufgetragen, sondern in einem Gieß- und Schüttverfahren auf die Oberfläche gebracht werden. So kann die Masse in sich verlaufen.
          </p>
          <p class="text-sm text-neutral-300 leading-relaxed font-normal">
            Dies führt immer zu einem einzigartigen, lebendigen Bild – so wird sichergestellt, dass jeder Kunde sein persönliches Unikat erhält. Für die Fertigung ist höchstes handwerkliches Geschick und eine optimal aufeinander abgestimmte Baustoffkombination notwendig.
          </p>
          <button
            type="button"
            data-open-gallery="betonboden"
            data-gallery-title="Betonböden im Gießverfahren"
            data-gallery-images={JSON.stringify(betonboeden)}
            data-start-index="0"
            class="px-5 py-2.5 bg-[#181818] hover:bg-[#f0dc28] text-white hover:text-black border border-white/15 text-xs font-semibold uppercase tracking-wider transition-all cursor-pointer inline-flex items-center gap-2"
          >
            <span>Böden-Galerie öffnen ({betonboeden.length} Fotos)</span>
          </button>
        </div>

        <div id="waende" class="lg:col-span-6 space-y-6 scroll-mt-28">
          <span class="text-xs uppercase tracking-[0.2em] font-medium text-[#f0dc28]">
            Betonwände mit Charakter • Wände
          </span>
          <h2 class="font-serif text-3xl sm:text-4xl font-normal text-white leading-tight">
            Kalk-Marmor-Gemisch mit Wachsbeschichtung.
          </h2>
          <p class="text-sm text-neutral-300 leading-relaxed font-normal">
            Unsere Wandflächen in Betonoptik bestehen aus einem Kalk-Marmor-Gemisch mit abschließender Versiegelung und Wachsbeschichtung, was dem Ganzen einen alten, coolen und »speckigen« Charakter verleiht.
          </p>
          <p class="text-sm text-neutral-300 leading-relaxed font-normal">
            Solche Flächen sind wie Kunstwerke zu verstehen: Farben und Formen, das Hell-Dunkel sowie Einschlüsse (Lunker) können verändert werden – so bestimmen Sie im Detail Ihr Unikat selbst mit.
          </p>
          <button
            type="button"
            data-open-gallery="betonwand"
            data-gallery-title="Sichtbetonwände & Loft-Design"
            data-gallery-images={JSON.stringify(betonwaende)}
            data-start-index="0"
            class="px-5 py-2.5 bg-[#181818] hover:bg-[#f0dc28] text-white hover:text-black border border-white/15 text-xs font-semibold uppercase tracking-wider transition-all cursor-pointer inline-flex items-center gap-2"
          >
            <span>Wände-Galerie öffnen ({betonwaende.length} Fotos)</span>
          </button>
        </div>

      </div>
    </div>
  </section>

  <!-- Real Photo Gallery Grid -->
  <section class="py-20 bg-[#0a0a0a] text-white border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end mb-16 pb-6 border-b border-white/10 gap-4">
        <div class="space-y-2">
          <span class="text-xs uppercase tracking-[0.2em] font-medium text-[#f0dc28]">
            Original-Objekte
          </span>
          <h2 class="font-serif text-3xl sm:text-4xl font-normal text-white">
            Realisierte Böden & Wandflächen ({allBetonImages.length} Fotos).
          </h2>
        </div>
        <button
          type="button"
          data-open-gallery="beton"
          data-gallery-title="Betonböden & Sichtbetonwände"
          data-gallery-images={JSON.stringify(allBetonImages)}
          data-start-index="0"
          class="px-6 py-3 bg-[#f0dc28] text-black font-semibold text-xs uppercase tracking-wider hover:bg-white transition-all cursor-pointer shrink-0"
        >
          Alle {allBetonImages.length} Fotos in Galerie öffnen
        </button>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
        {allBetonImages.map((src, idx) => (
          <div
            class="relative aspect-[4/3] bg-black overflow-hidden border border-white/10 cursor-pointer hover:border-[#f0dc28] transition-all group"
            data-open-gallery="beton"
            data-gallery-title={`Beton Unikat #${idx + 1}`}
            data-gallery-images={JSON.stringify(allBetonImages)}
            data-start-index={idx}
          >
            <img
              src={src}
              alt={`Betonoptik Projekt ${idx + 1}`}
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
              <span class="text-white text-xs font-mono bg-black/80 px-2 py-1 border border-white/20">
                🔍 #{idx + 1}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section (GEO & SEO) -->
  <section class="py-20 bg-[#0e0e0e] text-white border-b border-white/10">
    <div class="max-w-4xl mx-auto px-4 sm:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
        <span class="text-xs uppercase tracking-[0.2em] font-medium text-[#f0dc28]">
          Häufige Fragen
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl font-normal text-white">
          Wissenswertes zu unseren Betonböden & Wänden.
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="p-6 bg-[#141414] border border-white/10">
            <h3 class="font-serif text-lg font-medium text-white mb-2">
              {faq.q}
            </h3>
            <p class="text-sm text-neutral-300 font-normal leading-relaxed">
              {faq.a}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Project Planner Funnel -->
  <ProjectPlanner />

  <!-- Global Lightbox -->
  <GalleryLightbox />
</Layout>

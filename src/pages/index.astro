---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ServicePillars from '../components/ServicePillars.astro';
import KineticMorphShowcase from '../components/KineticMorphShowcase.astro';
import BadprofisTeaser from '../components/BadprofisTeaser.astro';
import MaterialShowcase from '../components/MaterialShowcase.astro';
import PartnerTrust from '../components/PartnerTrust.astro';
import Testimonials from '../components/Testimonials.astro';
import ProjectPlanner from '../components/ProjectPlanner.astro';
---

<Layout
  title="Dino Bruns Raumdesign | Fugenlose Betonböden & Frescolori® Kalkmarmorputz Krefeld"
  description="Exklusives Oberflächenstudio in Krefeld für Betonböden im Gießverfahren, edlen Frescolori® Kalkmarmorputz, fugenlose Bäder und textile Raumausstattung im Rheinland."
>
  <!-- Hero Section with Gliding Filmstrip Marquee -->
  <Hero />

  <!-- 3 Service Pillars with Alternating Feature Rows -->
  <ServicePillars />

  <!-- Kinetic Morph Showcase (Scroll-driven Reveal & Scale) -->
  <KineticMorphShowcase />

  <!-- Badprofis Co-Brand Feature -->
  <BadprofisTeaser />

  <!-- Material & Texture Showcase -->
  <MaterialShowcase />

  <!-- Premium Partner Network -->
  <PartnerTrust />

  <!-- Client & Architect Testimonials -->
  <Testimonials />

  <!-- Interactive Project Planner Lead Funnel -->
  <ProjectPlanner />
</Layout>

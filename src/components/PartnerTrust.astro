---
const partners = [
  { name: 'Frescolori®', role: 'Zertifizierter Meisterbetrieb', origin: 'Bocholt / Italien' },
  { name: 'JAB Anstoetz', role: 'Teppiche & Polsterstoffe', origin: 'Bielefeld' },
  { name: 'Christian Fischbacher', role: 'Schweizer Edelluxus', origin: 'St. Gallen' },
  { name: 'Dedar Milano', role: 'Haute-Couture Textil', origin: 'Mailand' },
  { name: 'interstil', role: 'Präzisions-Vorhangsysteme', origin: 'Steinhagen' },
  { name: 'Orac Decor®', role: 'Architektur-Wandprofile', origin: 'Belgien' },
];
---

<section class="py-20 bg-[#0e0e0e] text-white border-b border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-12 pb-6 border-b border-white/10">
      <div>
        <span class="text-xs uppercase tracking-[0.2em] font-medium text-[#f0dc28] block mb-1">
          Geprüfte Hersteller-Exzellenz
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl font-normal text-white">
          Ausgewählte Partner & Manufakturen.
        </h2>
      </div>
      <p class="text-xs text-neutral-300 uppercase tracking-wider">
        Kompromisslose Werkstoffqualität
      </p>
    </div>

    <!-- Partner Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-px bg-white/10 border border-white/10">
      {partners.map((partner) => (
        <div class="p-6 bg-[#141414] text-center flex flex-col justify-center items-center hover:bg-[#1a1a1a] transition-colors">
          <span class="font-serif text-lg font-medium text-white mb-1">
            {partner.name}
          </span>
          <span class="text-[10px] text-neutral-300 leading-tight">
            {partner.role}
          </span>
          <span class="text-[9px] uppercase tracking-widest text-[#f0dc28] mt-2">
            {partner.origin}
          </span>
        </div>
      ))}
    </div>

  </div>
</section>

---
const currentYear = new Date().getFullYear();
---

<!-- Architectural Closing CTA Banner (Refined Dark Luxury with Signature Yellow Line) -->
<section class="w-full bg-[#0e0e0e] text-white py-16 px-4 sm:px-8 border-t-2 border-[#f0dc28] border-b border-white/10 relative overflow-hidden bg-ambient-spotlight">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start md:items-center gap-8">
    <div class="space-y-3">
      <div class="inline-flex items-center gap-2">
        <span class="w-2 h-2 bg-[#f0dc28]"></span>
        <span class="text-[11px] uppercase tracking-[0.25em] font-semibold text-[#f0dc28] block">
          Atelier & Showroom Krefeld
        </span>
      </div>
      <h3 class="font-serif text-3xl sm:text-4xl md:text-5xl font-normal text-white leading-tight">
        Jeder Raum ein Unikat. Handwerk mit Leidenschaft.
      </h3>
    </div>

    <a
      href="/kontakt"
      class="inline-flex items-center justify-center px-8 py-4 bg-[#f0dc28] text-black hover:bg-white text-xs font-semibold uppercase tracking-widest transition-all shadow-lg shrink-0 cursor-pointer"
    >
      <span>Showroom-Termin anfragen</span>
      <span class="ml-2 font-bold">→</span>
    </a>
  </div>
</section>

<footer class="bg-[#050505] text-neutral-300 pt-20 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    
    <!-- Top Footer Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 pb-16 border-b border-white/10">
      
      <!-- Col 1: Brand & Atelier Story (Left 5 Cols) -->
      <div class="md:col-span-5 space-y-5">
        <a href="/" class="inline-block">
          <img 
            src="/images/logo/dino-bruns-logo.png" 
            alt="Dino Bruns Raumdesign" 
            class="h-9 w-auto object-contain brightness-110"
            width="160"
            height="36"
          />
        </a>
        <p class="text-xs sm:text-sm text-neutral-300 font-normal leading-relaxed max-w-sm">
          High-End Raumdesign & Oberflächenstudio. Seit über 25 Jahren Ihr Meisterbetrieb für Betonböden im Gießverfahren, Frescolori® Kalkmarmorputz und textile Raumkonzepte in Krefeld, Meerbusch, Düsseldorf und dem Rheinland.
        </p>
        <div class="text-[11px] uppercase tracking-[0.15em] text-[#f0dc28] font-semibold pt-2">
          Eingetragener Meisterbetrieb der Handwerkskammer Düsseldorf
        </div>
      </div>

      <!-- Col 2: Disziplinen & Studio (Right 7 Cols Split) -->
      <div class="md:col-span-7 grid grid-cols-2 sm:grid-cols-3 gap-8">
        
        <div class="space-y-3">
          <h4 class="text-[11px] font-bold uppercase tracking-[0.15em] text-white">Leistungen</h4>
          <ul class="space-y-2 text-xs text-neutral-300">
            <li><a href="/betonoptik" class="hover:text-white transition-colors">Betonböden & Wände</a></li>
            <li><a href="/kalkmarmorputz" class="hover:text-white transition-colors">Frescolori® Bäder</a></li>
            <li><a href="/raumausstattung#energiesparen" class="hover:text-white transition-colors">Energiesparen & Plissees</a></li>
            <li><a href="/raumausstattung#innenausbau" class="hover:text-white transition-colors">Innenausbau & Sanierung</a></li>
            <li><a href="/raumausstattung#bodenbelaege" class="hover:text-white transition-colors">Bodenbeläge & Parkett</a></li>
            <li><a href="/raumausstattung#schiebetueren" class="hover:text-white transition-colors">Schiebetüren & Raumteiler</a></li>
            <li><a href="/raumausstattung#vorhangsysteme" class="hover:text-white transition-colors">interstil Vorhänge</a></li>
            <li><a href="/raumausstattung#teppiche" class="hover:text-white transition-colors">JAB Anstoetz Teppiche</a></li>
            <li><a href="/raumausstattung#dekorationen" class="hover:text-white transition-colors">Dekorationen & Mooswände</a></li>
            <li><a href="/raumausstattung#sonnenschutz" class="hover:text-white transition-colors">Sonnenschutz & Jalousien</a></li>
            <li><a href="/raumausstattung#bettwaesche" class="hover:text-white transition-colors">Fischbacher Bettwäsche</a></li>
          </ul>
        </div>

        <div class="space-y-3">
          <h4 class="text-[11px] font-bold uppercase tracking-[0.15em] text-white">Studio</h4>
          <ul class="space-y-2 text-xs text-neutral-300">
            <li><a href="/projekte" class="hover:text-white transition-colors">Projekt-Galerie</a></li>
            <li><a href="/ueber-uns" class="hover:text-white transition-colors">Über Dino Bruns</a></li>
            <li><a href="/kontakt" class="hover:text-white transition-colors">Showroom-Besuch</a></li>
            <li class="pt-2">
              <a 
                href="https://badprofis.pro" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="text-[#f0dc28] font-semibold hover:underline block"
              >
                badprofis.pro ↗
              </a>
            </li>
          </ul>
        </div>

        <div class="space-y-3 col-span-2 sm:col-span-1">
          <h4 class="text-[11px] font-bold uppercase tracking-[0.15em] text-white">Standort</h4>
          <div class="text-xs text-neutral-300 space-y-1.5 font-normal">
            <p class="text-white font-medium">Grotenburgstraße 106<br />47800 Krefeld</p>
            <p>Tel: <a href="tel:+492151391919" class="hover:text-white font-medium text-[#f0dc28]">02151 391919</a></p>
            <p>E-Mail: <a href="mailto:info@dino-bruns.de" class="hover:text-white">info@dino-bruns.de</a></p>
          </div>
        </div>

      </div>

    </div>

    <!-- Bottom Legal Row -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] uppercase tracking-[0.15em] text-neutral-500">
      <div>
        © {currentYear} Dino Bruns Raumdesign.
      </div>
      
      <div class="flex items-center gap-6">
        <a href="/impressum" class="hover:text-white transition-colors">Impressum</a>
        <a href="/datenschutz" class="hover:text-white transition-colors">Datenschutz</a>
        <a href="/kontakt" class="hover:text-white transition-colors">Kontakt</a>
      </div>
    </div>

  </div>
</footer>

---
---

<section class="py-24 bg-[#0a0a0a] text-white border-b border-white/10 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    <div class="border border-[#f0dc28]/30 bg-[#121212] p-8 sm:p-12 md:p-16">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
        
        <!-- Left Column: Co-Brand Story -->
        <div class="lg:col-span-8 space-y-6">
          <div class="text-xs uppercase tracking-[0.2em] text-[#f0dc28] font-medium">
            Schlüsselfertige Komplettbad-Sanierung
          </div>

          <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-normal leading-tight text-white">
            Badprofis by Dino & Lutz: <br class="hidden sm:inline" />
            Ihr Traumbad aus einer Meisterhand.
          </h2>

          <p class="text-sm sm:text-base text-neutral-300 font-normal leading-relaxed max-w-2xl">
            Sie planen ein schlüsselfertiges Komplettbad ohne Schnittstellenverlust? In unserer etablierten Kooperation bündeln <strong class="text-white font-medium">Dino Bruns</strong> (Oberflächenmeister für fugenlosen Frescolori® Kalkmarmorputz) und <strong class="text-white font-medium">Lutz Kottsieper</strong> (lukoteam, Meister für Sanitär- & Heizungstechnik) ihr gesamtes Know-how.
          </p>

          <!-- Key Synergy Points -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-white/10">
            <div>
              <span class="text-xs uppercase tracking-widest text-[#f0dc28] font-semibold block mb-1">01 / Planung</span>
              <h4 class="text-sm font-medium text-white mb-1">3D-Visualisierung</h4>
              <p class="text-xs text-neutral-300 font-normal">Fotorealistische Badplanung vor Baubeginn.</p>
            </div>

            <div>
              <span class="text-xs uppercase tracking-widest text-[#f0dc28] font-semibold block mb-1">02 / Sanitär</span>
              <h4 class="text-sm font-medium text-white mb-1">Installations-Meister</h4>
              <p class="text-xs text-neutral-300 font-normal">Rohbau, Entwässerung & Armaturentechnik.</p>
            </div>

            <div>
              <span class="text-xs uppercase tracking-widest text-[#f0dc28] font-semibold block mb-1">03 / Oberfläche</span>
              <h4 class="text-sm font-medium text-white mb-1">Fugenlose Veredelung</h4>
              <p class="text-xs text-neutral-300 font-normal">Wasserdichte Frescolori® Kalkmarmor-Wandkunst.</p>
            </div>
          </div>
        </div>

        <!-- Right Column: Direct Link & Action Box -->
        <div class="lg:col-span-4 flex flex-col justify-center space-y-6 border-t lg:border-t-0 lg:border-l border-white/15 lg:pl-12 pt-8 lg:pt-0">
          <div>
            <span class="text-[10px] uppercase tracking-widest text-[#f0dc28] font-semibold block mb-2">Exklusiver Partner-Kanal</span>
            <h3 class="text-2xl font-serif text-white font-normal mb-2">badprofis.pro</h3>
            <p class="text-xs text-neutral-300 mb-6 font-normal leading-relaxed">
              Für die vollständige Sanitärplanung, 3D-Badvorschauen und Festpreis-Konzepte.
            </p>
            
            <a
              href="https://badprofis.pro"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center px-6 py-4 text-xs font-semibold uppercase tracking-widest text-black bg-[#f0dc28] hover:bg-white transition-all duration-200"
            >
              Zu Badprofis.pro wechseln ↗
            </a>
          </div>

          <p class="text-[11px] text-neutral-300">
            Reine Wandveredelungen und Oberflächensanierungen beauftragen Sie weiterhin direkt bei Dino Bruns.
          </p>
        </div>

      </div>

    </div>
  </div>
</section>
